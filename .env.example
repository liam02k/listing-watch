# Copy to .env and source it:  set -a; source .env; set +a
# Every one of these is optional except DISCORD_WEBHOOK_URL.

# ---- the only thing you MUST fill in ----
DISCORD_WEBHOOK_URL="PASTE_YOUR_DISCORD_WEBHOOK_URL_HERE"

# ---- everything below already defaults to what you asked for ----
# Both the "-slammer" exclusion and the missing _sacat are load-bearing:
# without them eBay auto-corrects to "slammer" and returns 2019 Slam Attax
# singles instead of the 2026 SLAMMED insert set. See README, "The search URL".
EBAY_SEARCH_URL="https://www.ebay.com/sch/i.html?_nkw=wwe+universe+slammed+-slammer&_sop=10"

# Alert on listings AT OR ABOVE this price. Inclusive: 45 means $45.00 qualifies.
# There is no upper bound -- however expensive a listing is, it alerts.
EBAY_PRICE_THRESHOLD=45

EBAY_POLL_INTERVAL=300
EBAY_STATE_FILE=seen_items.json

# Alert on listings that are already up the very first time you run it.
# Default 0 = record them silently so you don't get 60 messages at once.
EBAY_ALERT_ON_FIRST_RUN=0

# Safety valve: most alerts to fire in a single poll.
EBAY_MAX_ALERTS_PER_CYCLE=10

# Forget seen item IDs after this many days.
EBAY_STATE_RETENTION_DAYS=45

# Which HTTP client fetches eBay: auto | requests | httpx | curl_cffi
# "auto" = requests -> httpx -> curl_cffi. requests+warm-up is what was measured
# to work; curl_cffi is last because it soft-blocks SILENTLY (200, no listings).
# Re-run deploy/diagnose.py if eBay starts returning 403 again.
EBAY_HTTP_CLIENT=auto

# Re-warm the session (re-fetch eBay's bot cookies) at least this often, seconds.
EBAY_WARM_MAX_AGE=1800

EBAY_LOG_LEVEL=INFO
# EBAY_LOG_FILE=ebay_monitor.log

DISCORD_USERNAME="eBay Watch"
